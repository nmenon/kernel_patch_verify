#!/bin/bash

export DOCKER_ARGS IMG_NAME KP_PATH SEMCODE_DB

# Check if Docker image exists

# Use Directly from github container registry if not provided:
# dockerhub location is nishanthmenon/arm-kernel-dev
IMG_NAME="${IMG_NAME:-ghcr.io/nmenon/arm-kernel-dev}"

# TBD: If we are using from github -> I need to figure out how to get that working..

# If we are building locally
# IMG_NAME=arm-kernel-dev

# Check if docker exists
docker=$(which docker)
if [ -z "$docker" ]; then
	echo "Please install Docker to be able to function"
	exit 1
fi

# If we are working off docker image from github container reg, make sure
# we have the latest.
if [ "$IMG_NAME" = "ghcr.io/nmenon/arm-kernel-dev" ]; then
	docker pull "$IMG_NAME"
fi
ccache=$(which ccache 2> /dev/null)
if [ -z "$ccache" ]; then
	if [ ! -d "/tmp/ccache" ]; then
		mkdir /tmp/ccache
	fi
	CCACHEDIR=/tmp/ccache
else
	CCACHEDIR=$(ccache -s|grep "cache directory"|sed -e "s/\s\s*/ /g"|cut -d ' ' -f3|xargs echo)
	if [ -z "$CCACHEDIR" ]; then
		CCACHEDIR=$(ccache -v -s|grep -i "cache directory"|sed -e "s/\s\s*/ /g"|cut -d ':' -f2|xargs echo)
	fi
fi

DOCKER_ARGS=()
DOCKER_ARGS+=(-v /tmp:/tmp)
DOCKER_ARGS+=(-v /opt:/opt)
DOCKER_ARGS+=(-v "$CCACHEDIR":/ccache)
# DOCKER_ARGS+=(-v "$(dirname "$(readlink -f "$0")")/kernel_patch_verify":/usr/bin/kernel_patch_verify)

# Check if current directory is a git directory
if ! git rev-parse --is-inside-work-tree > /dev/null; then
	exit 1
fi

ROOT_GIT=$(git rev-parse --show-toplevel)
# if a submodule or worktree then we need to fetch and preserve the gitdir path
if [ -f "${ROOT_GIT}/.git" ]; then
	gitdir_str=$(grep -P -o '(?<=gitdir:\s).*' "${ROOT_GIT}/.git")
	relative_str=$(echo "$gitdir_str" | grep -P -o '^(../)*')
	if [ -n "$relative_str" ]; then
		# relative paths need to be preserved
		common_path=$(realpath "$ROOT_GIT/$relative_str")
		relative_pwd=$(realpath --relative-to="$common_path" "$PWD")
		DOCKER_ARGS+=(-v "$common_path":"/workdir")
		DOCKER_ARGS+=(-w "/workdir/${relative_pwd}")
	else
		# absolute paths can be passed through
		gitdir_path=$(git rev-parse --git-common-dir)
		DOCKER_ARGS+=(-v "$ROOT_GIT":"/workdir")
		DOCKER_ARGS+=(-v "$gitdir_path":"$gitdir_path")
	fi
else
	# normal git directory, just toss everything in
	DOCKER_ARGS+=(-v "$ROOT_GIT":"/workdir")
fi

# list of paths to append to the PATH variable in the container
extra_paths=(
	/workdir/scripts/dtc
	/opt/cross-gcc-linux-14/bin
	/opt/cross-gcc-linux-13/bin
	/opt/cross-gcc-linux-12/bin
	/opt/cross-gcc-linux-11/bin
	/opt/cross-gcc-linux-10/bin
	/opt/cross-gcc-linux-9/bin
)

# Mount Claude settings if they exist
if [ -z "$KPV_CLAUDE_SETTINGS" ]; then
	KPV_CLAUDE_SETTINGS="$HOME/.claude/settings.json"
fi
if [ -f "$KPV_CLAUDE_SETTINGS" ]; then
	DOCKER_ARGS+=(-v "$KPV_CLAUDE_SETTINGS":/config/.claude/settings.json)
fi

# Mount SEMCODE_DB directory if it exists
if [ -n "${SEMCODE_DB}" ] && [ -d "${SEMCODE_DB}" ]; then
	DOCKER_ARGS+=(-v "${SEMCODE_DB}":"${SEMCODE_DB}")
	DOCKER_ARGS+=(-e SEMCODE_DB="${SEMCODE_DB}")
fi

if [ -n "${AI_LOG_ALWAYS}" ]; then
	DOCKER_ARGS+=(-e AI_LOG_ALWAYS="${AI_LOG_ALWAYS}")
fi

if [ -n "${DOCKER_NETWORK_HOST}" ]; then
	DOCKER_ARGS+=(--network host)
fi

if [ -z "${CLAUDE_MODEL}" ] && [ -n "${OPENAI_API_MODEL}" ]; then
	CLAUDE_MODEL="${OPENAI_API_MODEL}"
fi
if [ -n "${CLAUDE_MODEL}" ]; then
	DOCKER_ARGS+=(-e CLAUDE_MODEL="${CLAUDE_MODEL}")
fi

# Pass OpenAPI key if defined to the container environment for PatchWise
if [ -n "${OPENAI_API_KEY}" ]; then
	DOCKER_ARGS+=(-e OPENAI_API_KEY="${OPENAI_API_KEY}")
	DOCKER_ARGS+=(-e ANTHROPIC_API_KEY="${OPENAI_API_KEY}")
	if [ -n "${OPENAI_API_PROVIDER}" ]; then
		DOCKER_ARGS+=(-e OPENAI_API_PROVIDER="${OPENAI_API_PROVIDER}")
	fi
	if [ -n "${OPENAI_API_MODEL}" ]; then
		DOCKER_ARGS+=(-e OPENAI_API_MODEL="${OPENAI_API_MODEL}")
	fi
fi

# Sashiko (sashiko-review) settings. Sashiko reads SASHIKO_CONFIG, else
# $XDG_CONFIG_HOME/sashiko.toml, else $HOME/.config/sashiko.toml, and layers
# SASHIKO__* environment variables on top. Mirror that lookup here.
sashiko_cfg=""
if [ -n "${SASHIKO_CONFIG:-}" ]; then
	if [ -f "${SASHIKO_CONFIG}" ]; then
		sashiko_cfg="${SASHIKO_CONFIG}"
	else
		echo "Warning: SASHIKO_CONFIG=${SASHIKO_CONFIG} is not a regular file; ignoring it" >&2
	fi
elif [ -n "${XDG_CONFIG_HOME:-}" ]; then
	if [ -f "${XDG_CONFIG_HOME}/sashiko.toml" ]; then
		sashiko_cfg="${XDG_CONFIG_HOME}/sashiko.toml"
	fi
elif [ -f "${HOME}/.config/sashiko.toml" ]; then
	sashiko_cfg="${HOME}/.config/sashiko.toml"
fi

if [ -n "${sashiko_cfg}" ]; then
	# User's own settings win: mount read-only, do not map OPENAI_API_* over it.
	DOCKER_ARGS+=(-v "${sashiko_cfg}":/config/sashiko-user.toml:ro)
	DOCKER_ARGS+=(-e SASHIKO_CONFIG=/config/sashiko-user.toml)
else
	# Map the shared OPENAI_API_* variables, only where Sashiko is not set explicitly.
	if [ -n "${OPENAI_API_MODEL:-}" ] && [ -z "${SASHIKO__AI__MODEL+x}" ]; then
		export SASHIKO__AI__MODEL="${OPENAI_API_MODEL}"
	fi
	if [ -n "${OPENAI_API_PROVIDER:-}" ] && [ -z "${SASHIKO__AI__PROVIDER+x}" ]; then
		case "${OPENAI_API_PROVIDER}" in
		http://*|https://*)
			export SASHIKO__AI__PROVIDER=openai-compatible
			if [ -z "${SASHIKO__AI__OPENAI_COMPAT__BASE_URL+x}" ]; then
				export SASHIKO__AI__OPENAI_COMPAT__BASE_URL="${OPENAI_API_PROVIDER}"
			fi
			if [ -z "${DOCKER_NETWORK_HOST:-}" ]; then
				case "${OPENAI_API_PROVIDER}" in
				*://localhost*|*://127.0.0.1*)
					echo "Hint: ${OPENAI_API_PROVIDER} points at localhost; set DOCKER_NETWORK_HOST=1 so the container can reach it" >&2
					;;
				esac
			fi
			;;
		*)
			sashiko_prov=$(printf '%s' "${OPENAI_API_PROVIDER}" | tr '[:upper:]' '[:lower:]')
			case "${sashiko_prov}" in
			anthropic) sashiko_prov=claude ;;
			gemini|claude|openai|openai-compatible|vllm|ollama|*-cli) ;;
			*)
				echo "Warning: OPENAI_API_PROVIDER=${OPENAI_API_PROVIDER} is not a known Sashiko provider; not mapped" >&2
				sashiko_prov=""
				;;
			esac
			if [ -n "${sashiko_prov}" ]; then
				export SASHIKO__AI__PROVIDER="${sashiko_prov}"
			fi
			;;
		esac
	fi
fi

# Forward every SASHIKO_* / SASHIKO__* variable by name (never NAME=value so
# secrets stay out of the docker argument list). SASHIKO_CONFIG is handled above.
for sashiko_var in $(compgen -e); do
	case "${sashiko_var}" in
	SASHIKO_CONFIG) ;;
	SASHIKO_*) DOCKER_ARGS+=(-e "${sashiko_var}") ;;
	esac
done
for passthru_var in GEMINI_API_KEY LLM_API_KEY VLLM_API_KEY ANTHROPIC_BASE_URL; do
	if [ -n "${!passthru_var:-}" ]; then
		DOCKER_ARGS+=(-e "${passthru_var}")
	fi
done
if [ -z "${OPENAI_API_KEY:-}" ] && [ -n "${ANTHROPIC_API_KEY:-}" ]; then
	DOCKER_ARGS+=(-e ANTHROPIC_API_KEY)
fi

KP_PATH=$(IFS=:; printf '%s' "${extra_paths[*]}")
